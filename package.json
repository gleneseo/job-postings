{
  "name": "job-postings",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "bin": {
    "job-postings": "dist/src/index.js"
  },
  "scripts": {
    "clean": "rimraf dist .coverage .eslint",
    "build": "npm-run-all clean prettier:check lint build:tsc test:coverage docker:build proof",
    "build:tsc": "tsc",
    "start": "tsx src/index.ts",
    "start:env": "tsx --env-file=.env.example src/index.ts",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:unit": "vitest --run --project unit",
    "test:integration": "vitest --run --project integration",
    "prettier:check": "prettier . --check --no-editorconfig --ignore-unknown",
    "prettier:write": "prettier . --write --no-editorconfig --ignore-unknown",
    "lint": "npm-run-all lint:eslint",
    "lint:eslint": "eslint .",
    "lint:eslint:report": "eslint . --output-file=.eslint/report.html --format=html",
    "docker:build": " docker build . --tag job-postings:latest",
    "docker:run": " docker run --rm -it -t job-postings:latest",
    "proof": "git rev-parse HEAD | cowsay -r",
    "prepare": "husky && effect-language-service patch"
  },
  "keywords": [],
  "author": "Gleneseo Engineering",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": "^12.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@effect/language-service": "^0.87.2",
    "@effect/vitest": "^4.0.0-rc.111",
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "cowsay": "^1.6.0",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.9.6",
    "rimraf": "^6.1.3",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*": "prettier --write --no-editorconfig --ignore-unknown"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.0-rc.111",
    "effect": "^4.0.0-rc.111",
    "googleapis": "^176.0.0"
  }
}
