{
  "name": "job-postings",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "bin": {
    "job-postings": "dist/src/index.js"
  },
  "scripts": {
    "clean": "rimraf dist .coverage .eslint",
    "build": "npm-run-all clean prettier:check lint build:tsc test:coverage proof",
    "build:tsc": "tsc",
    "start": "tsx src/index.ts",
    "start:env": "tsx --env-file=.env.example src/index.ts",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:unit": "vitest --run --project unit",
    "test:integration": "vitest --run --project integration",
    "prettier:check": "prettier . --check --no-editorconfig --ignore-unknown",
    "prettier:write": "prettier . --write --no-editorconfig --ignore-unknown",
    "lint": "npm-run-all lint:eslint",
    "lint:eslint": "eslint .",
    "lint:eslint:report": "eslint . --output-file=.eslint/report.html --format=html",
    "proof": "git rev-parse HEAD | cowsay -r",
    "prepare": "husky && effect-language-service patch"
  },
  "keywords": [],
  "author": "Gleneseo Engineering",
  "license": "Unlicense",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": "^12.2.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@effect/language-service": "^0.87.5",
    "@effect/vitest": "^4.1.4",
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@tsconfig/node26": "^26.0.2",
    "@tsconfig/strictest": "^2.0.9",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "cowsay": "^1.6.0",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.18.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.10.1",
    "rimraf": "^6.1.4",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*": "prettier --write --no-editorconfig --ignore-unknown"
  },
  "dependencies": {
    "@effect/platform-node": "^4.1.4",
    "effect": "^4.1.4",
    "googleapis": "^190.0.0"
  }
}
